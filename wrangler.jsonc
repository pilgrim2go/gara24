{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gara24-d1-spike",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Giao diện (web/dist, build bằng `npm --prefix web run build`). Các đường dẫn API luôn vào Worker trước.
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/dev/*", "/webhooks/*", "/probe/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gara24",
      // Thay bằng id thật sau khi chạy: npx wrangler d1 create gara24
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
